# 远端大模型配置（OpenAI 兼容协议）。不配置则自动使用内置规则引擎兜底。
#
# ⚠️ 本文件是模板；真实密钥只写进 .env（已在 .gitignore 中）。
#    提交前自查：git status 不应出现 .env；git log --all -- .env 应为空。

# ---- 智谱 AI（GLM）示例 ----
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash

# ---- DeepSeek 示例（二选一）----
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

# ---- 通义千问 DashScope 兼容模式示例 ----
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 单次模型调用超时（秒）。慢环另有 llm_budget 的次数/墙钟上限兜底。
LLM_TIMEOUT=30
LLM_CALL_TIMEOUT=15

# ---- 运行模式 ----
# 设为 1：强制不发起任何模型请求（规则与结构化路径照常工作）。断网演练/回归测试用。
LLM_OFFLINE=

# 运行时状态目录（习惯/经验/日报/自定义事件路由）。默认 <仓库>/data。
# XIJIAN_DATA_DIR 优先；LINGXI_DATA_DIR 为旧名回退（迁移期兼容）。
# 回归测试应指向临时目录，避免污染真实用户数据。
# XIJIAN_DATA_DIR=D:/tmp/xijian-data
